<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20261103100000-1" author="facundo">
    <createTable tableName="weekly_schedule">
      <column name="id" type="bigint">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="professional_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="day_of_week" type="varchar(10)">
        <constraints nullable="false"/>
      </column>
      <column name="start_time" type="${timeType}">
        <constraints nullable="false"/>
      </column>
      <column name="end_time" type="${timeType}">
        <constraints nullable="false"/>
      </column>
      <column name="slot_duration_minutes" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="enabled" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="${datetimeType}"/>
      <column name="updated_at" type="${datetimeType}"/>
    </createTable>

    <createIndex tableName="weekly_schedule" indexName="idx_weekly_schedule_professional">
      <column name="professional_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
